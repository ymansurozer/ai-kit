{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["import", "node", "promise", "typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn",
    "style": "off",
    "pedantic": "off",
    "restriction": "off"
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/no-unsafe-type-assertion": "off",
    "import/no-anonymous-default-export": ["error", { "allowObject": true, "allowArray": true }],
    "curly": "error"
  },
  "ignorePatterns": ["bun.lock"],
  "options": {
    "typeAware": true
  },
  "env": {
    "builtin": true,
    "node": true,
    "es2024": true
  }
}
